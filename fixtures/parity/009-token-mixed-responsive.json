{
  "description": "Mix of token ref and raw values with a responsive token ref at tablet breakpoint",
  "breakpoints": [
    { "id": "desktop", "label": "Desktop", "width": 9999, "direction": "max", "builtin": true },
    { "id": "tablet",  "label": "Tablet",  "width": 768,  "direction": "max", "builtin": true }
  ],
  "tokens": [
    { "id": "color-primary", "group": "color", "name": "Primary", "value": "#3b82f6" }
  ],
  "tree": {
    "rootId": "root",
    "nodes": {
      "root": {
        "id": "root",
        "type": "section",
        "props": {
          "backgroundColor": "#ffffff",
          "color": { "base": "#111111", "tablet": { "__token": "color-primary" } }
        },
        "children": [],
        "overrides": {},
        "meta": {}
      }
    }
  },
  "css": ":root{--nx-color-primary:#3b82f6}.nivorax-root{color:#111111;background-color:#ffffff}@media (max-width:768px){.nivorax-root{color:var(--nx-color-primary)}}"
}
