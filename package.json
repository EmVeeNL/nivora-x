{
  "name": "nivorax-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NivoraX editor app (React + TypeScript)",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev":          "vite",
    "build":        "vite build",
    "typecheck":    "tsc --noEmit",
    "lint":         "eslint app",
    "lint:fix":     "eslint app --fix",
    "format":       "prettier --write \"app/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css,json}\""
  },
  "dependencies": {
    "react":     "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react":                   "^18.3.0",
    "@types/react-dom":               "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser":      "^8.0.0",
    "@vitejs/plugin-react":           "^4.3.0",
    "eslint":                         "^9.0.0",
    "eslint-config-prettier":         "^9.1.0",
    "eslint-plugin-react":            "^7.36.0",
    "eslint-plugin-react-hooks":      "^5.0.0",
    "prettier":                       "^3.3.0",
    "typescript":                     "^5.6.0",
    "vite":                           "^6.0.0"
  }
}
