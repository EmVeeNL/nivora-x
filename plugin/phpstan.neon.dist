includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6

    paths:
        - nivorax.php
        - src
        - uninstall.php

    excludePaths:
        - vendor

    # WP constants / functions are declared by the phpstan-wordpress extension.
    # Add any project-level bootstrap globals here as needed.
    bootstrapFiles: []

    # Relax rule: WordPress often passes mixed arrays; tighten per-phase.
    checkMissingIterableValueType: false
