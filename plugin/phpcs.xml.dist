<?xml version="1.0"?>
<ruleset name="NivoraX">
  <description>NivoraX WordPress plugin — PHPCS ruleset.</description>

  <!-- Files to scan -->
  <file>nivorax.php</file>
  <file>src/</file>
  <file>tests/</file>
  <file>uninstall.php</file>

  <!-- Exclude generated/vendor dirs -->
  <exclude-pattern>vendor/*</exclude-pattern>
  <exclude-pattern>node_modules/*</exclude-pattern>

  <!-- Encoding -->
  <arg name="encoding" value="utf-8"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <!-- Base rule: WordPress (includes WordPress-Core, WordPress-Docs, WordPress-Extra) -->
  <rule ref="WordPress">
    <!-- Allow short array syntax [] instead of array() -->
    <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
    <!-- Universal variant of the same rule -->
    <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
    <!-- PSR-4 naming convention; WordPress class-*.php naming not used -->
    <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
    <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
  </rule>

  <!-- Minimum supported PHP / WP versions -->
  <config name="minimum_supported_wp_version" value="7.0"/>
  <config name="testVersion" value="8.5-"/>

  <!-- Text domain -->
  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="nivorax"/>
      </property>
    </properties>
  </rule>

  <!-- PSR-4 class files carry class-level docblocks; file-level comments are redundant -->
  <rule ref="Squiz.Commenting.FileComment.Missing">
    <exclude-pattern>src/*</exclude-pattern>
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>

  <!-- Custom capabilities registered by this plugin -->
  <rule ref="WordPress.WP.Capabilities">
    <properties>
      <property name="custom_capabilities" type="array">
        <element value="nivorax_edit_pages"/>
        <element value="nivorax_manage_settings"/>
      </property>
    </properties>
  </rule>

</ruleset>
