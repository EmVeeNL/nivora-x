# ─────────────────────────────────────────────────────────────────────────────
# NivoraX — local environment variables
# Copy to .env and fill in values. .env is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Database
DB_ROOT_PASSWORD=rootsecret
DB_NAME=nivorax
DB_USER=nivorax
DB_PASSWORD=nivorax

# WordPress
WP_PORT=8080
WP_URL=http://localhost:8080
WP_TITLE=NivoraX Dev
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@nivorax.local
WP_TABLE_PREFIX=wp_

# Mailhog
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# Xdebug — set to "debug" or "coverage" to enable; leave "off" for normal runs
XDEBUG_MODE=off
